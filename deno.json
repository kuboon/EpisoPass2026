{
  "tasks": {
    "build": "deno bundle src/index.html --outdir=dist && cp static/* dist/",
    "serve": "deno run --allow-net --allow-read=dist jsr:@std/http/file-server dist"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"]
  },
  "permissions": {
    "build": {
      "read": ["src"],
      "write": ["dist"]
    },
    "serve": {
      "net": true,
      "read": ["dist"]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.16"
  }
}
